# Chimera — Arquivo de configuração de variáveis de ambiente
# Copie este arquivo para .env e preencha as chaves de API desejadas
# As fontes que requerem autenticação são opcionais — a ferramenta funciona sem elas

# ============================================================
# OTX AlienVault — https://otx.alienvault.com (gratuito após cadastro)
# Usada para buscar pulsos e IoCs associados a atores de ameaça
# ============================================================
OTX_API_KEY=

# ============================================================
# VirusTotal — https://virustotal.com (tier gratuito disponível)
# Usada para enriquecer ferramentas/malwares com detecções e metadados
# ============================================================
VT_API_KEY=

# ============================================================
# MISP — instância local/remota (opcional)
# Necessário configurar URL + chave de autenticação
# ============================================================
MISP_URL=
MISP_API_KEY=

# ============================================================
# OpenCTI — instância local/remota (opcional)
# API GraphQL; necessário URL + Bearer token
# ============================================================
OPENCTI_URL=
OPENCTI_API_KEY=

# ============================================================
# NVD (National Vulnerability Database) — https://nvd.nist.gov
# Chave opcional: melhora rate-limit (50 req/30s vs 5 req/30s sem chave)
# Cadastro em: https://nvd.nist.gov/developers/request-an-api-key
# ============================================================
NVD_API_KEY=

# ============================================================
# ThreatFox (Abuse.ch) — https://threatfox.abuse.ch
# Não requer autenticação; chave opcional para recursos adicionais
# ============================================================
THREATFOX_API_KEY=

# ============================================================
# MalwareBazaar (Abuse.ch) — https://bazaar.abuse.ch
# Não requer autenticação por padrão; chave opcional para recursos adicionais
# ============================================================
MALWAREBAZAAR_API_KEY=

# ============================================================
# Malpedia — https://malpedia.caad.fkie.fraunhofer.de
# Optional API token: improves rate-limit and unlocks authenticated endpoints.
# Register at https://malpedia.caad.fkie.fraunhofer.de/register
# Without a token, anonymous (read-only) access is used automatically.
# Set MALPEDIA_ENRICHMENT_ENABLED=false to disable enrichment entirely.
# ============================================================
MALPEDIA_API_TOKEN=
MALPEDIA_ENRICHMENT_ENABLED=true

# ============================================================
# LLM Query Generator (Module 4 — QueryGenLLM)
# Generates SIEM/EDR detection queries from Sigma Rules (Layer A)
# and from MITRE ATT&CK TTP context (Layer B).
#
# Supported providers: openai | anthropic | google | ollama | azure_openai | ibm_ica
#   openai      → OpenAI Chat Completions (gpt-4o, gpt-4-turbo, ...)
#   anthropic   → Anthropic Messages API  (claude-3-5-sonnet, ...)
#   google      → Google Generative AI    (gemini-1.5-pro, ...)
#   ollama      → Local Ollama server     (llama3, mistral, ...)
#   azure_openai→ Azure OpenAI deployment (set LLM_BASE_URL to deployment base URL)
#   ibm_ica     → IBM ICA agents/chat/completions endpoint.
#                 LLM_BASE_URL MUST be the FULL endpoint URL including the path:
#                   LLM_BASE_URL=https://<host>/ica/v1/agents/chat/completions
#                 LLM_MODEL is sent in the request body (e.g. gpt-5.5-gus).
#                 temperature and max_tokens are omitted (rejected with HTTP 400).
#                 stream=false and accept: application/json are set automatically.
#
# Set LLM_QUERY_GEN_ENABLED=true to activate the module.
# Supported backends: qradar | cortex_xdr | crowdstrike | splunk | elastic | sentinel | opensearch
# ============================================================
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_BASE_URL=
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
LLM_QUERY_GEN_ENABLED=false

# ============================================================
# LLM Fallback for FindAPTGroups (Module 1)
# When ETDA Threat Group Cards returns no results for a searched group,
# the LLM agent is automatically invoked as a secondary data source.
# The LLM response follows the ETDA schema and is clearly marked as
# LLM-sourced (_llm_source: true) for traceability.
#
# Reuses the same provider/key/model settings defined above — no extra
# credentials required.
#
# Set LLM_APT_FALLBACK_ENABLED=true to activate.
# ============================================================
LLM_APT_FALLBACK_ENABLED=false

# ============================================================
# Cache de API (TTL em segundos, padrão: 86400 = 24 horas)
# ============================================================
CACHE_TTL=86400

# ============================================================
# Nível de log: DEBUG, INFO, WARNING, ERROR
# ============================================================
LOG_LEVEL=INFO
